# -- Wallet ------------------------------------------------------------------
# node -e console.log(require('crypto').randomBytes(32).toString('hex'))
WALLET_PRIVATE_KEY_BASE58=        # 88-char base58 private key - NEVER commit the real value

# -- RPC ---------------------------------------------------------------------
HELIUS_RPC_URL=                   # https://mainnet.helius-rpc.com/?api-key=...
HELIUS_API_KEY=                   # optional; used when HELIUS_RPC_URL is bare
HELIUS_RPC_URL_FALLBACK=          # optional, reads only

# -- Jupiter -----------------------------------------------------------------
JUPITER_BASE_URL=https://api.jup.ag/swap/v1/
JUPITER_API_KEY=                  # required for api.jup.ag/* endpoints
RUN_LIVE_JUPITER_TESTS=false
JUPITER_LIVE_TEST_MINTS=

# -- Jito --------------------------------------------------------------------
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# -- Submission --------------------------------------------------------------
SUBMISSION_MODE=rpc               # rpc | helius_sender | jito
SUBMISSION_FALLBACK_RPC=true
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
HELIUS_SENDER_TIP_LAMPORTS=200000

# -- Webhook -----------------------------------------------------------------
WEBHOOK_SECRET=                   # min 32 bytes: openssl rand -hex 32
WEBHOOK_PORT=8080
TOKENS_INGEST_BASE_URL=http://127.0.0.1:3001
TOKENS_INGEST_SERVICE_SECRET=     # min 32 bytes; must match tokens_ingest POSITION_SERVICE_SECRET
FLOW_EXIT_POLL_ENABLED=false
FLOW_EXIT_POLL_INTERVAL_MS=30000

# -- Intelligence layer ------------------------------------------------------
# Every signal must include intelligence_decision (action=probe, lane=core_ev)
# unless LEGACY_TRADING_ENABLED=true (not recommended in production).
LEGACY_TRADING_ENABLED=false

# Hard cap on any single trade after the intelligence gate clamps the amount.
# MUST be >= live setting per_trade_sol_cap or trades will hit per_signal_cap blocker.
# Default live per_trade_sol_cap = 0.001 SOL. For tiny mode align both values.
# Example: TRADER_MAX_STAKE_SOL=0.005 then set per_trade_sol_cap=0.005 via live-settings.
TRADER_MAX_STAKE_SOL=0.005

# Maximum confirmed trades per calendar day (UTC).
TRADER_MAX_TRADES_PER_DAY=20

# Declared but not yet enforced as blockers. Reserved for future implementation.
TRADER_DAILY_LOSS_LIMIT_SOL=0.1       # future: stop buys when realised day loss exceeds this
TRADER_DAILY_NOTIONAL_LIMIT_SOL=0.2   # future: independent daily spend cap

# -- Risk --------------------------------------------------------------------
# Startup defaults only. Live settings override these at runtime without restart.
# Manage live values: pnpm ops:live-settings list / set <key> <value>
DAILY_SOL_CAP=0.1                 # startup fallback; live setting daily_sol_cap takes precedence
PER_SIGNAL_SOL_CAP=0.0001         # startup fallback; live setting per_trade_sol_cap takes precedence
PER_TOKEN_COOLDOWN_MINUTES=30
WALLET_SOL_FLOOR=0.15
DEFAULT_SLIPPAGE_BPS=300          # parsed but unused at runtime; live max_slippage_bps is used

# -- Tripwires ---------------------------------------------------------------
RUGCHECK_API_KEY=                 # optional; tripwire deps not wired, no runtime effect
TRIPWIRES_AS_BLOCKERS=false

# -- Observability -----------------------------------------------------------
TRADE_TELEGRAM_BOT_TOKEN=
TRADE_TELEGRAM_CHAT_ID=
LOG_LEVEL=info
LOG_FILE=                         # optional: path for JSON log file alongside stdout

# -- Modes -------------------------------------------------------------------
KILL_SWITCH=false
DRY_RUN=false                     # largely removed from buy path; use live_execution_enabled instead

# -- Priority fee ------------------------------------------------------------
PRIORITY_FEE_LEVEL=High           # Medium | High | VeryHigh
PRIORITY_FEE_HARD_CAP_MICROLAMPORTS=4000000
PRIORITY_FEE_FALLBACK_MICROLAMPORTS=50000

# -- SLO ---------------------------------------------------------------------
SLO_WINDOW_HOURS=1

# -- Database ----------------------------------------------------------------
DATABASE_URL=file:./data/bot.db